.order-card {
  padding: 24rpx 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.order-phone {
  font-size: 28rpx;
  color: #333;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-arrow {
  font-size: 24rpx;
  color: #1890ff;
}

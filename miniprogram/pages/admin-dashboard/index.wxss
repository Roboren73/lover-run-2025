.page { background:#f5f5f5; min-height:100vh; }
.hero { background:#111; color:#fff; padding:32rpx 24rpx 48rpx; }
.title { font-size:42rpx; font-weight:700; }
.sub { margin-top:8rpx; font-size:26rpx; color:#ddd; }
.card { background:#fff; border-radius:20rpx; margin:-20rpx 24rpx 24rpx; padding:20rpx; }
.card-title { font-size:32rpx; font-weight:700; margin-bottom:16rpx; }
.grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }
.cell { background:#fafafa; border:1rpx solid #eee; border-radius:12rpx; padding:16rpx; text-align:center; }
.count { font-size:36rpx; font-weight:700; }
.label { font-size:22rpx; color:#666; }
.row { display:flex; justify-content:space-between; padding:16rpx 0; border-bottom:1rpx solid #f0f0f0; }

.action { margin-top: 16rpx; background:#111; color:#fff; }

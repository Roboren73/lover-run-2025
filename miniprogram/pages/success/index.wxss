.page { min-height:100vh; background:#f5f5f5; display:flex; align-items:center; justify-content:center; padding:24rpx; }
.card { width:100%; background:#fff; border-radius:20rpx; padding:40rpx 24rpx; text-align:center; }
.ok { width:96rpx; height:96rpx; margin:0 auto 20rpx; border-radius:50%; background:#52c41a; color:#fff; font-size:60rpx; line-height:96rpx; }
.title { font-size:42rpx; font-weight:700; margin-bottom:12rpx; }
.desc { color:#666; margin-bottom:28rpx; }
.btn-primary { background:#1677ff; color:#fff; margin-bottom:12rpx; }
.btn-ghost { background:#fff; color:#333; border:1px solid #ddd; }

<view class="container">
  <view wx:if="{{loading}}" class="loading-state">加载中...</view>

  <block wx:if="{{order && !loading}}">
    <!-- 状态卡片 -->
    <view class="card status-card">
      <view class="status-big status-{{order.status}}">{{order.statusText}}</view>
      <view class="order-no-text">订单号：{{order.orderNo}}</view>
    </view>

    <!-- 基本信息 -->
    <view class="card">
      <view class="section-title">报修信息</view>
      <view class="detail-row">
        <text class="detail-label">手机号</text>
        <text class="detail-value">{{order.phone}}</text>
      </view>
      <view class="detail-row" wx:if="{{order.name}}">
        <text class="detail-label">姓名</text>
        <text class="detail-value">{{order.name}}</text>
      </view>
      <view class="detail-row" wx:if="{{order.address}}">
        <text class="detail-label">地址</text>
        <text class="detail-value">{{order.address}}</text>
      </view>
      <view class="detail-row" wx:if="{{order.description}}">
        <text class="detail-label">问题描述</text>
        <text class="detail-value">{{order.description}}</text>
      </view>
      <view class="detail-row">
        <text class="detail-label">提交时间</text>
        <text class="detail-value">{{order.createdAtText}}</text>
      </view>
      <view class="detail-row" wx:if="{{order.updatedAtText}}">
        <text class="detail-label">更新时间</text>
        <text class="detail-value">{{order.updatedAtText}}</text>
      </view>
      <view class="detail-row" wx:if="{{order.remark}}">
        <text class="detail-label">备注</text>
        <text class="detail-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 图片 -->
    <view class="card" wx:if="{{order.images && order.images.length > 0}}">
      <view class="section-title">现场照片</view>
      <view class="image-gallery">
        <image class="gallery-img" wx:for="{{order.images}}" wx:key="*this"
          src="{{item}}" mode="aspectFill"
          bindtap="previewImage" data-url="{{item}}" />
      </view>
    </view>
  </block>
</view>

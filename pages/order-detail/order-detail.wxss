.status-card {
  text-align: center;
  padding: 40rpx;
}

.status-big {
  font-size: 40rpx;
  font-weight: bold;
  padding: 12rpx 32rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}

.order-no-text {
  font-size: 24rpx;
  color: #999;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  width: 160rpx;
  color: #999;
  font-size: 26rpx;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  color: #333;
  font-size: 26rpx;
  word-break: break-all;
}

.image-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gallery-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
}

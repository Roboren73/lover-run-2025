.login-header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
}

.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.logout-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
}

.stats-card .stats-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #1890ff;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.source-stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.source-stat-item:last-child {
  border-bottom: none;
}

.source-stat-name {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.source-stat-id {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.source-stat-total {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
  display: block;
  text-align: right;
}

.source-stat-done {
  font-size: 22rpx;
  color: #52c41a;
  display: block;
  text-align: right;
  margin-top: 4rpx;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.action-text {
  font-size: 30rpx;
  color: #333;
}

.action-arrow {
  font-size: 28rpx;
  color: #ccc;
}

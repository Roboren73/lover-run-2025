.store-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

.store-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.logout-btn {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 6rpx;
}

.filter-bar {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.filter-item.active {
  background-color: #1890ff;
  color: #fff;
}

.order-card {
  padding: 24rpx 30rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 26rpx;
  color: #999;
}

.order-info {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.order-phone {
  font-size: 28rpx;
  color: #333;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-arrow {
  font-size: 24rpx;
  color: #1890ff;
}

.add-btn {
  margin-bottom: 24rpx;
}

.source-card {
  padding: 24rpx 30rpx;
}

.source-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.source-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.source-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.source-type-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  color: #fff;
}

.source-type-tag.store {
  background-color: #1890ff;
}

.source-type-tag.referrer {
  background-color: #722ed1;
}

.source-status {
  font-size: 24rpx;
  font-weight: bold;
}

.source-status.active {
  color: #52c41a;
}

.source-status.disabled {
  color: #999;
}

.source-info {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.source-info-row {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.source-actions {
  display: flex;
  justify-content: flex-end;
  gap: 30rpx;
  padding-top: 16rpx;
}

.action-link {
  font-size: 26rpx;
  color: #1890ff;
  flex-shrink: 0;
}

.action-link.primary {
  font-weight: bold;
}

.action-link.warn {
  color: #ff4d4f;
}

.action-link.success {
  color: #52c41a;
}

.radio-label {
  margin-right: 40rpx;
  font-size: 28rpx;
}
